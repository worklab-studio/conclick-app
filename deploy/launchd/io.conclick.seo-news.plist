<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.conclick.seo-news</string>

  <!-- 4x/day, each slot at least 50 minutes clear of a daily-content run
       (09:12, 14:22, 18:42) so the shared working-tree lock never has to
       arbitrate. This routine is cheap: it searches, judges, and usually
       queues nothing. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/worklab/Conclick beta/umami/scripts/seo/run-routine.sh</string>
    <string>news-watch</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>40</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/worklab/.conclick-seo-logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/worklab/.conclick-seo-logs/launchd.err.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/worklab/Conclick beta/umami</string>

  <key>Nice</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
