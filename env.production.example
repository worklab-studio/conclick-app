# Conclick Production Environment Variables
# Copy this to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_DB=umami
POSTGRES_USER=umami
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Connection string (auto-constructed in docker-compose, but needed for standalone)
DATABASE_URL=postgresql://umami:CHANGE_THIS_TO_A_STRONG_PASSWORD@db:5432/umami

# =============================================================================
# APP SECURITY
# =============================================================================
# Generate with: openssl rand -base64 32
APP_SECRET=CHANGE_THIS_TO_RANDOM_SECRET

# =============================================================================
# APP SETTINGS
# =============================================================================
APP_PORT=3000

# Optional: Custom base path (e.g., /analytics)
# BASE_PATH=

# Optional: Custom tracker script name for ad-blocker bypass
# TRACKER_SCRIPT_NAME=custom.js

# =============================================================================
# BILLING (Dodo Payments)
# =============================================================================
# API key: Dodo dashboard -> Developer -> API keys (live mode)
# DODO_PAYMENTS_API_KEY=
# Signing secret of the webhook you point at /api/webhooks/dodo
# DODO_WEBHOOK_SECRET=
# Product ids printed by `npx tsx scripts/create-dodo-products.ts`
# DODO_MONTHLY_PRODUCT_ID=
# DODO_LIFETIME_PRODUCT_ID=
# Optional: point at https://test.dodopayments.com for test mode
# DODO_API_BASE=

# =============================================================================
# GOOGLE (Search Console + GA4 import) - Optional
# =============================================================================
# OAuth client (type "Web application") from console.cloud.google.com with
# redirect URI: ${NEXT_PUBLIC_APP_URL}/api/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# =============================================================================
# SLACK (one-click "Add to Slack" for notifications) - Optional
# =============================================================================
# Slack app (api.slack.com/apps) with the incoming-webhook scope, public
# distribution enabled, and redirect URL ${NEXT_PUBLIC_APP_URL}/api/slack/callback
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================
# Enable cloud mode features
# CLOUD_MODE=1

# Force HTTPS redirect
# FORCE_SSL=1
